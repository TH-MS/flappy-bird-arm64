class_name Atlas
extends RefCounted
## Sprite rectangles (pixels) inside assets/gfx/atlas.png (1024x1024).
## GENERATED by tools/gen_atlas.py from the original res/raw/atlas.txt - do not hand-edit.
## If the sheet is missing the game still runs with flat-colour placeholders.

const SHEET_PATH := "res://assets/gfx/atlas.png"

const RECTS: Dictionary = {
#@RECTS@
}

static var _sheet: Texture2D = null
static var _sheet_checked := false
static var _cache: Dictionary = {}

static func has_sheet() -> bool:
	_load_sheet()
	return _sheet != null

static func _load_sheet() -> void:
	if _sheet_checked:
		return
	_sheet_checked = true
	if ResourceLoader.exists(SHEET_PATH):
		_sheet = load(SHEET_PATH) as Texture2D
	if _sheet == null:
		push_warning("Atlas: %s not found - using placeholder art. Run tools/extract_assets.sh" % SHEET_PATH)

static func size_of(sprite: String) -> Vector2:
	return Vector2((RECTS[sprite] as Rect2i).size)

## Whole sprite as a texture.
static func tex(sprite: String) -> Texture2D:
	if _cache.has(sprite):
		return _cache[sprite]
	assert(RECTS.has(sprite), "Unknown sprite '%s'" % sprite)
	var r: Rect2i = RECTS[sprite]
	var t: Texture2D = _region(Rect2(r)) if _has_art() else _placeholder(sprite, r.size)
	_cache[sprite] = t
	return t

## A single pixel row of a sprite (stretch it vertically to extend pipes / sky).
static func strip(sprite: String, row: int = 0) -> Texture2D:
	var key := "%s#row%d" % [sprite, row]
	if _cache.has(key):
		return _cache[key]
	var r: Rect2i = RECTS[sprite]
	var t: Texture2D
	if _has_art():
		t = _region(Rect2(r.position.x, r.position.y + row, r.size.x, 1))
	else:
		t = _placeholder(sprite, Vector2i(r.size.x, 1))
	_cache[key] = t
	return t

static func _has_art() -> bool:
	_load_sheet()
	return _sheet != null

static func _region(rect: Rect2) -> Texture2D:
	var at := AtlasTexture.new()
	at.atlas = _sheet
	at.region = rect
	at.filter_clip = true      # no bleeding from neighbouring sprites when scaled
	return at

static func _placeholder(sprite: String, size: Vector2i) -> Texture2D:
	var c := Color(0.55, 0.55, 0.6)
	if sprite.begins_with("bg_"): c = Color(0.31, 0.75, 0.79)
	elif sprite.begins_with("pipe"): c = Color(0.45, 0.75, 0.2)
	elif sprite.begins_with("land"): c = Color(0.87, 0.85, 0.58)
	elif sprite.begins_with("bird"): c = Color(0.97, 0.78, 0.2)
	elif sprite.begins_with("button") or sprite.begins_with("score_panel"): c = Color(0.9, 0.55, 0.2)
	elif sprite.begins_with("font") or sprite.begins_with("number"): c = Color(1, 1, 1)
	elif sprite == "white": c = Color.WHITE
	elif sprite == "black": c = Color.BLACK
	var img := Image.create(maxi(size.x, 1), maxi(size.y, 1), false, Image.FORMAT_RGBA8)
	img.fill(c)
	return ImageTexture.create_from_image(img)
