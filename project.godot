; Engine configuration file.
; Flappy64 - 64-bit (arm64-v8a) Godot 4 port, delta-time based for 60/90/120/144 Hz.

config_version=5

[application]

config/name="Flappy64"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=0
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=288
window/size/viewport_height=512
window/size/window_width_override=576
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/frame_pacing/android/enable_frame_pacing=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.306, 0.753, 0.792, 1)
